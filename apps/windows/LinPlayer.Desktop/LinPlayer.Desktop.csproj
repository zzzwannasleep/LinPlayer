<Project Sdk="Microsoft.NET.Sdk">

  <!-- LinPlayer 的 Windows 端外壳。**UI 层不包含任何业务逻辑** ——
       所有数据与播放都经由 core/ 的 13 个 FFI 导出(SPEC §5.1)。
       同一份代码之后要在 Linux 上跑(TODO B2.3),所以别写 Windows 专有 API,
       除非确实只有 Windows 需要(那时用 OperatingSystem.IsWindows() 圈起来)。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 本地开发的回落版本;发布时由 CI 用 -p:Version= 覆盖。
         唯一权威是仓库根的 VERSION 文件,见 docs/VERSIONING.md。 -->
    <Version>1.1.0-dev</Version>
    <AssemblyName>LinPlayer</AssemblyName>
    <RootNamespace>LinPlayer.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- ★★ 发布时预编译成机器码(ReadyToRun)。
         启动那一秒钟里最大的一块是 **JIT**:Avalonia + Win32 + 图形初始化那条路
         每次开机都要现编一遍。R2R 把它提前编好,代价是包大一些。
         这是发布专用属性,dotnet build 不受影响。 -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- ★★ exe 自己的图标。用户 2026-09-03:「软件没有图标,以前有的,用回以前那个就行」。
         ★ 正本现在在 **Assets/**。2026-09-04 删 Rust 栈之前它在 apps/desktop/icons/,
           C# 端跨栈引它 —— 那边一删,这边当场编不过(FileNotFoundException,
           而且报在 Avalonia 的资源生成任务里,乍看不像是图标的事)。
           「只留一处正本」的原则没变,只是正本跟着唯一还活着的端走。 -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同一个文件再进一次资源:exe 图标(上面那条)管的是**文件在资源管理器里的样子**,
         窗口图标(任务栏 / Alt-Tab / 标题栏)得由代码在运行期设,见 MainWindow 构造函数。 -->
    <!-- 图标。2026-09-04 之前这里指向 ..\..\desktop\icons\(Tauri 端的资源) ——
         Rust 栈一删,C# 端当场编不过。资源不跨栈借,自己这份放 Assets/。 -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 命令绑定是**生成的**(scripts/gen-bindings.py),不许手写。
         266 x 3 = 798 次抄写机会,错的那几次全是运行时才发现。 -->
    <ProjectReference Include="..\..\..\bindings\csharp\LinPlayer.Core.csproj" />
  </ItemGroup>

</Project>
