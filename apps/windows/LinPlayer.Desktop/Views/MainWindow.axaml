<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LinPlayer.Desktop.Views.MainWindow"
        Title="LinPlayer"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <!--
    外壳骨架(UI_PC §3.1):
      自绘标题栏 36px  |  侧栏 212px  |  内容区(正文封顶 1560,左右水槽 18)

    自绘标题栏必须留**拖拽区**:不留的话窗口拖不动,而用户第一反应是「卡死了」。
  -->
  <Grid Name="RootGrid" RowDefinitions="36,*">

    <!-- ══════ 标题栏 ══════ -->
    <Grid Grid.Row="0" Name="TitleBar" Background="{DynamicResource Panel}"
          ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" Spacing="10"
                  VerticalAlignment="Center">
        <Border Name="BrandDot" Width="16" Height="16" CornerRadius="6" ClipToBounds="True"
                Background="{DynamicResource Accent}" />
        <TextBlock Text="LinPlayer" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- 拖拽区:整条中段都能拖 -->
      <Border Grid.Column="1" Background="Transparent" Name="DragArea" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="caption" Name="BtnMin" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
        <Button Classes="caption" Name="BtnMax" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
        <Button Classes="caption close" Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
      </StackPanel>
    </Grid>

    <!-- ══════ 主体 ══════ -->
    <!-- 列宽是 <b>Auto</b>,真实宽度在侧栏自己的 Width 上 ——
         GridLength **不可动画**,而用户 2026-09-03 点名要收放动效。
         把宽度挪到 Border.Width 上之后,一条 DoubleTransition 就够了。 -->
    <Grid Name="BodyGrid" Grid.Row="1" ColumnDefinitions="Auto,*">

      <!-- 侧栏。折叠态 72px 只留图标(Tokens 里的 SidebarCollapsedWidth)。
           ClipToBounds:收起过程中里面的文字比列还宽,不裁的话会漏到内容区上。 -->
      <Border Name="Sidebar" Grid.Column="0" Width="212" ClipToBounds="True"
              Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Border.Transitions>
          <Transitions>
            <!-- 220ms:比换页那 180 稍长一点 —— 这一下是「布局在变形」,
                 太快会看成闪动;再长会挡住用户下一步操作。 -->
            <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut" />
          </Transitions>
        </Border.Transitions>
        <DockPanel LastChildFill="True">

          <!-- 底部:设置 + 折叠 / 展开 -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
            <RadioButton Classes="nav" Name="NavSettings" GroupName="nav" Content="设置" Tag="&#xE713;" />
            <!-- 折叠开关放**底部**,和导航项同一套版式。
                 折叠态下图标要和上面那一列**对齐到同一条竖线**(用户 2026-09-03 点名:
                   「收起/展开没有和其他图标一样居中」)。导航项靠 .icononly 把图标撑成 56 宽,
                   这一个是 Button、吃不到那条选择器 —— 所以在 ToggleSidebar 里手动同步。 -->
            <Button Name="BtnCollapse" Classes="navbtn" Height="38" Margin="10,6,10,0"
                    Padding="10,0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Background="Transparent"
                    BorderThickness="0" CornerRadius="6" Cursor="Hand"
                    Foreground="{DynamicResource Ink2}">
              <StackPanel Name="CollapseBox" Orientation="Horizontal" Spacing="10">
                <TextBlock Name="CollapseIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Width="18" TextAlignment="Center"
                           Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
                <TextBlock Name="CollapseText" Text="收起侧栏" FontSize="13"
                           Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- 填充区 = 导航项 + 服务器区。
               用户 2026-09-03:「侧边栏的服务器不是放到和设置一块,他是**单独的一栏**,
               放在中部」—— 所以它不再和「设置 / 收起」一起停在底部,
               而是紧跟在导航项下面,自成一段。
               外面套 ScrollViewer:服务器多的时候(十几台)这一列会比侧栏高,
                 不套的话最下面几台点不到,而且**不报错**。 -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="0">
          <StackPanel Name="NavList" Spacing="0">
            <RadioButton Classes="nav" Name="NavHome" GroupName="nav" Content="首页" IsChecked="True" Tag="&#xE80F;" />
            <RadioButton Classes="nav" Name="NavBrowse" GroupName="nav" Content="文件浏览" IsVisible="False" Tag="&#xE8B7;" />
            <RadioButton Classes="nav" Name="NavCatalog" GroupName="nav" Content="影视目录" IsVisible="False" Tag="&#xE8A9;" />
            <RadioButton Classes="nav" Name="NavLibrary" GroupName="nav" Content="媒体库" Tag="&#xE8F1;" />
            <RadioButton Classes="nav" Name="NavSearch" GroupName="nav" Content="搜索" Tag="&#xE721;" />
            <RadioButton Classes="nav" Name="NavFavorites" GroupName="nav" Content="收藏" Tag="&#xE734;" />
            <RadioButton Classes="nav" Name="NavAggregate" GroupName="nav" Content="聚合视界" Tag="&#xE774;" />
            <RadioButton Classes="nav" Name="NavHistory" GroupName="nav" Content="观看历史" Tag="&#xE81C;" />
            <RadioButton Classes="nav" Name="NavDownload" GroupName="nav" Content="下载" Tag="&#xE896;" />
            <RadioButton Classes="nav" Name="NavRanking" GroupName="nav" Content="排行榜" Tag="&#xE8CB;" />
            <RadioButton Classes="nav" Name="NavCalendar" GroupName="nav" Content="追剧日历" Tag="&#xE787;" />
            <RadioButton Classes="nav" Name="NavPlugins" GroupName="nav" Content="插件" Tag="&#xE71D;" />
          </StackPanel>

          <!--
            服务器区。
            2026-09-03 用户点名:「侧边栏下面那些位置可以放服务器,
              只需要鼠标往左边点点就可以切换服务器;同时把服务器页的那些功能
              做成右键点击服务器就出现的功能;添加服务器做成在这些服务器的上面 ——
              这样就省略了服务器页和添加服务器页了」。
            所以顶上原来那块「服务器卡」没了:它只是一个**通往服务器页的入口**,
              而现在服务器本身就在侧栏里,那个入口没有存在的理由。
            内容由 C# 填(账号表是运行期才知道的),见 UpdateServerChip。
          -->
          <StackPanel Name="ServerSection" Margin="0,14,0,6">
            <Border Height="1" Margin="14,0,14,10" Background="{DynamicResource Line}" />
            <TextBlock Name="ServerSectionTitle" Text="服务器" Margin="18,0,0,6"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink3}" />
            <StackPanel Name="ServerList" Spacing="0" />
          </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 内容区 -->
      <Panel Grid.Column="1">
        <!--
          换页淡入淡出。
          用 TransitioningContentControl,不是自己在 Show() 里写动画 ——
             写在代码里的话每一个换页入口(侧栏 / Nav.Push / Nav.Back / 自检跳转)
             都得各记得动一次,漏掉的那个入口就是「只有这条路没有转场」。
          180ms:再长会挡住内容(用户等的是页面不是动画),
            再短就看不出来,等于白做。
          只淡不滑:滑动要选方向,而「返回」和「进入」的方向应当相反 ——
            这个栈没有方向信息,硬滑就会出现返回时也往左滑的错觉。
        -->
        <TransitioningContentControl Name="PageHost">
          <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.18" />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- 出错横幅。
             渲染里抛出的异常**原本会把整个进程打死** —— 没有对话框、没有日志窗口,
               用户看到的是「点了一下,软件没了」。现在由 Dispatcher.UnhandledException
               统一接住(见 App.axaml.cs)。
             接住之后**必须让它看得见**。默默吞掉的话就变成了本仓最讨厌的那种失败:
               不报错、不崩、只是这一块没画出来,而谁也不知道发生过什么。 -->
        <Border Name="ErrorBar" IsVisible="False"
                VerticalAlignment="Bottom" Margin="18" Padding="14,10"
                CornerRadius="10" Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource Danger}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Name="ErrorText" VerticalAlignment="Center" MaxWidth="900"
                       TextWrapping="Wrap" Foreground="{DynamicResource DangerInk}" />
            <Button Name="ErrorClose" Classes="ghost" Content="知道了" />
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</Window>
