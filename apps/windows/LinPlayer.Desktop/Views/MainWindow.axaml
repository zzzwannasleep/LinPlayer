<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LinPlayer.Desktop.Views.MainWindow"
        Title="LinPlayer"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <!--
    外壳骨架(UI_PC §3.1):
      自绘标题栏 36px  |  侧栏 212px  |  内容区(正文封顶 1560,左右水槽 18)

    ★ 自绘标题栏必须留**拖拽区**:不留的话窗口拖不动,而用户第一反应是「卡死了」。
  -->
  <Grid Name="RootGrid" RowDefinitions="36,*">

    <!-- ══════ 标题栏 ══════ -->
    <Grid Grid.Row="0" Name="TitleBar" Background="{DynamicResource Panel}"
          ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" Spacing="9"
                  VerticalAlignment="Center">
        <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource Accent}" />
        <TextBlock Text="LinPlayer" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- 拖拽区:整条中段都能拖 -->
      <Border Grid.Column="1" Background="Transparent" Name="DragArea" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="caption" Name="BtnMin" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
        <Button Classes="caption" Name="BtnMax" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
        <Button Classes="caption close" Name="BtnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
      </StackPanel>
    </Grid>

    <!-- ══════ 主体 ══════ -->
    <Grid Name="BodyGrid" Grid.Row="1" ColumnDefinitions="212,*">

      <!-- 侧栏 -->
      <Border Name="Sidebar" Grid.Column="0" Background="{DynamicResource Panel}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <!-- 服务器切换器 -->
          <!-- ★ 这块是**可点的**:点开就是服务器管理。
               没有入口的话登录一台之后就再也换不了服务器,而这是个多服务器播放器。 -->
          <Button DockPanel.Dock="Top" Name="ServerChip" Margin="10,12,10,10" Padding="10,9"
                  Background="{DynamicResource PanelAlt}" BorderThickness="0" CornerRadius="10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
            <StackPanel Spacing="2">
              <TextBlock Name="ServerName" Text="未连接" FontSize="13" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Name="ServerSub" Classes="dim" Text="还没有添加服务器"
                         FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>

          <!-- 底部:设置 -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
            <RadioButton Classes="nav" Name="NavSettings" GroupName="nav" Content="设置" />
          </StackPanel>

          <StackPanel Name="NavList" Spacing="0">
            <RadioButton Classes="nav" Name="NavHome" GroupName="nav" Content="首页" IsChecked="True" />
            <RadioButton Classes="nav" Name="NavBrowse" GroupName="nav" Content="文件浏览" IsVisible="False" />
            <RadioButton Classes="nav" Name="NavCatalog" GroupName="nav" Content="影视目录" IsVisible="False" />
            <RadioButton Classes="nav" Name="NavLibrary" GroupName="nav" Content="媒体库" />
            <RadioButton Classes="nav" Name="NavSearch" GroupName="nav" Content="搜索" />
            <RadioButton Classes="nav" Name="NavFavorites" GroupName="nav" Content="收藏" />
            <RadioButton Classes="nav" Name="NavAggregate" GroupName="nav" Content="聚合视界" />
            <RadioButton Classes="nav" Name="NavHistory" GroupName="nav" Content="观看历史" />
            <RadioButton Classes="nav" Name="NavDownload" GroupName="nav" Content="下载" />
            <RadioButton Classes="nav" Name="NavRanking" GroupName="nav" Content="排行榜" />
            <RadioButton Classes="nav" Name="NavCalendar" GroupName="nav" Content="追剧日历" />
            <RadioButton Classes="nav" Name="NavPlugins" GroupName="nav" Content="插件" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 内容区 -->
      <Panel Grid.Column="1">
        <!--
          换页淡入淡出。
          ★★ 用 TransitioningContentControl,不是自己在 Show() 里写动画 ——
             写在代码里的话每一个换页入口(侧栏 / Nav.Push / Nav.Back / 自检跳转)
             都得各记得动一次,漏掉的那个入口就是「只有这条路没有转场」。
          ★ 180ms:再长会挡住内容(用户等的是页面不是动画),
            再短就看不出来,等于白做。
          ★ 只淡不滑:滑动要选方向,而「返回」和「进入」的方向应当相反 ——
            这个栈没有方向信息,硬滑就会出现返回时也往左滑的错觉。
        -->
        <TransitioningContentControl Name="PageHost">
          <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.18" />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
      </Panel>
    </Grid>
  </Grid>
</Window>
