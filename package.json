{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:telemetry": "node ui/desktop/telemetry.check.ts",
    "check:shortcuts": "node --experimental-strip-types ui/desktop/lib/shortcuts.check.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "pack": "powershell -ExecutionPolicy Bypass -File scripts/pack-portable.ps1",
    "pack:fast": "powershell -ExecutionPolicy Bypass -File scripts/pack-portable.ps1 -NoZip"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.2.1",
    "@sentry/react": "^10.66.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
