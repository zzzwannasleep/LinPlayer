# 复制成 .env 再填,然后 chmod 600 .env
#
# ★ .env 绝不进版本控制。仓库里只留这份模板,一个真值都没有。
#   (仓库根的 .gitignore 已经拦了 .env,但换个目录部署时别忘了。)

# 弹弹Play 开发者凭据。
DANDANPLAY_APP_ID=
# ★ 如果你在弹弹那边配了**多串轮换密钥**,可以整坨粘进来(换行分隔),
#   服务只取第一串 —— 整坨拿去签名必然 403,而 403 长得跟"密钥无效"一模一样。
#   多行值在 .env 里不好写,建议就填一串。
DANDANPLAY_APP_SECRET=

# 管理界面密码,至少 8 位。没有默认密码 —— 不设服务直接拒绝启动。
# 这个界面能改出站闸门、能清空整个弹幕库,别用弱口令。
ADMIN_PASSWORD=

# 下面这些一般不用改(镜像里已有合适的默认值)。
# PORT=8787
# BIND=0.0.0.0
# DATA_DIR=/data
